set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(DEFINED ENV{ARM_GCC_BIN})
    file(TO_CMAKE_PATH "$ENV{ARM_GCC_BIN}" ARM_GCC_BIN)
    find_program(M1_ARM_CC NAMES arm-none-eabi-gcc arm-none-eabi-gcc.exe HINTS "${ARM_GCC_BIN}" REQUIRED NO_DEFAULT_PATH)
else()
    find_program(M1_ARM_CC NAMES arm-none-eabi-gcc arm-none-eabi-gcc.exe REQUIRED)
endif()
set(CMAKE_C_COMPILER "${M1_ARM_CC}")
set(CMAKE_ASM_COMPILER "${M1_ARM_CC}")
get_filename_component(ARM_TOOL_BIN "${CMAKE_C_COMPILER}" DIRECTORY)
find_program(ARM_OBJCOPY arm-none-eabi-objcopy HINTS "${ARM_TOOL_BIN}" REQUIRED)
find_program(ARM_SIZE arm-none-eabi-size HINTS "${ARM_TOOL_BIN}" REQUIRED)
